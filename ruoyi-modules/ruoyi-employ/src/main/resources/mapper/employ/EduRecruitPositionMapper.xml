<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.employ.mapper.EduRecruitPositionMapper">
    
    <resultMap type="EduRecruitPosition" id="EduRecruitPositionResult">
        <result property="positionId"    column="position_id"    />
        <result property="enterpriseId"    column="enterprise_id"    />
        <result property="positionName"    column="position_name"    />
        <result property="salaryRange"    column="salary_range"    />
        <result property="industryDetail"    column="industry_detail"    />
        <result property="jobRequirement"    column="job_requirement"    />
        <result property="recruitCount"    column="recruit_count"    />
        <result property="deadline"    column="deadline"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateUserId"    column="update_user_id"    />
        <result property="isDeleted"    column="is_deleted"    />
    </resultMap>

    <sql id="selectEduRecruitPositionVo">
        select position_id, enterprise_id, position_name, salary_range, industry_detail, job_requirement, recruit_count, deadline, status, create_time, update_time, update_user_id, is_deleted from edu_recruit_position
    </sql>

    <select id="selectEduRecruitPositionList" parameterType="EduRecruitPosition" resultMap="EduRecruitPositionResult">
        <include refid="selectEduRecruitPositionVo"/>
        <where>  
            <if test="enterpriseId != null "> and enterprise_id = #{enterpriseId}</if>
            <if test="positionName != null  and positionName != ''"> and position_name like concat('%', #{positionName}, '%')</if>
            <if test="salaryRange != null  and salaryRange != ''"> and salary_range = #{salaryRange}</if>
            <if test="industryDetail != null  and industryDetail != ''"> and industry_detail = #{industryDetail}</if>
            <if test="jobRequirement != null  and jobRequirement != ''"> and job_requirement = #{jobRequirement}</if>
            <if test="recruitCount != null "> and recruit_count = #{recruitCount}</if>
            <if test="deadline != null "> and deadline = #{deadline}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="updateUserId != null  and updateUserId != ''"> and update_user_id = #{updateUserId}</if>
            <if test="isDeleted != null "> and is_deleted = #{isDeleted}</if>
        </where>
    </select>
    
    <select id="selectEduRecruitPositionByPositionId" parameterType="Long" resultMap="EduRecruitPositionResult">
        <include refid="selectEduRecruitPositionVo"/>
        where position_id = #{positionId}
    </select>

    <insert id="insertEduRecruitPosition" parameterType="EduRecruitPosition" useGeneratedKeys="true" keyProperty="positionId">
        insert into edu_recruit_position
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="enterpriseId != null">enterprise_id,</if>
            <if test="positionName != null and positionName != ''">position_name,</if>
            <if test="salaryRange != null and salaryRange != ''">salary_range,</if>
            <if test="industryDetail != null">industry_detail,</if>
            <if test="jobRequirement != null">job_requirement,</if>
            <if test="recruitCount != null">recruit_count,</if>
            <if test="deadline != null">deadline,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateUserId != null and updateUserId != ''">update_user_id,</if>
            <if test="isDeleted != null">is_deleted,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="enterpriseId != null">#{enterpriseId},</if>
            <if test="positionName != null and positionName != ''">#{positionName},</if>
            <if test="salaryRange != null and salaryRange != ''">#{salaryRange},</if>
            <if test="industryDetail != null">#{industryDetail},</if>
            <if test="jobRequirement != null">#{jobRequirement},</if>
            <if test="recruitCount != null">#{recruitCount},</if>
            <if test="deadline != null">#{deadline},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateUserId != null and updateUserId != ''">#{updateUserId},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
         </trim>
    </insert>

    <update id="updateEduRecruitPosition" parameterType="EduRecruitPosition">
        update edu_recruit_position
        <trim prefix="SET" suffixOverrides=",">
            <if test="enterpriseId != null">enterprise_id = #{enterpriseId},</if>
            <if test="positionName != null and positionName != ''">position_name = #{positionName},</if>
            <if test="salaryRange != null and salaryRange != ''">salary_range = #{salaryRange},</if>
            <if test="industryDetail != null">industry_detail = #{industryDetail},</if>
            <if test="jobRequirement != null">job_requirement = #{jobRequirement},</if>
            <if test="recruitCount != null">recruit_count = #{recruitCount},</if>
            <if test="deadline != null">deadline = #{deadline},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateUserId != null and updateUserId != ''">update_user_id = #{updateUserId},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
        </trim>
        where position_id = #{positionId}
    </update>

    <delete id="deleteEduRecruitPositionByPositionId" parameterType="Long">
        delete from edu_recruit_position where position_id = #{positionId}
    </delete>

    <delete id="deleteEduRecruitPositionByPositionIds" parameterType="String">
        delete from edu_recruit_position where position_id in 
        <foreach item="positionId" collection="array" open="(" separator="," close=")">
            #{positionId}
        </foreach>
    </delete>
</mapper>