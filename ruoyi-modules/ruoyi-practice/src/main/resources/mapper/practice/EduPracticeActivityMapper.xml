<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.practice.mapper.EduPracticeActivityMapper">
    
    <resultMap type="EduPracticeActivity" id="EduPracticeActivityResult">
        <result property="activityId"    column="activity_id"    />
        <result property="activityName"    column="activity_name"    />
        <result property="activityType"    column="activity_type"    />
        <result property="organizer"    column="organizer"    />
        <result property="coOrganizer"    column="co_organizer"    />
        <result property="activityTime"    column="activity_time"    />
        <result property="activityEndTime"    column="activity_end_time"    />
        <result property="signStartTime"    column="sign_start_time"    />
        <result property="signEndTime"    column="sign_end_time"    />
        <result property="activityLocation"    column="activity_location"    />
        <result property="maxQuota"    column="max_quota"    />
        <result property="targetGroup"    column="target_group"    />
        <result property="activityDesc"    column="activity_desc"    />
        <result property="requiredMaterial"    column="required_material"    />
        <result property="activityStatus"    column="activity_status"    />
        <result property="createUserId"    column="create_user_id"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateUserId"    column="update_user_id"    />
        <result property="isDeleted"    column="is_deleted"    />
    </resultMap>

    <sql id="selectEduPracticeActivityVo">
        select activity_id, activity_name, activity_type, organizer, co_organizer, activity_time, activity_end_time, sign_start_time, sign_end_time, activity_location, max_quota, target_group, activity_desc, required_material, activity_status, create_user_id, create_time, update_time, update_user_id, is_deleted from edu_practice_activity
    </sql>

    <select id="selectEduPracticeActivityList" parameterType="EduPracticeActivity" resultMap="EduPracticeActivityResult">
        <include refid="selectEduPracticeActivityVo"/>
        <where>  
            <if test="activityName != null  and activityName != ''"> and activity_name like concat('%', #{activityName}, '%')</if>
            <if test="activityType != null "> and activity_type = #{activityType}</if>
            <if test="organizer != null  and organizer != ''"> and organizer = #{organizer}</if>
            <if test="coOrganizer != null  and coOrganizer != ''"> and co_organizer = #{coOrganizer}</if>
            <if test="activityTime != null "> and activity_time = #{activityTime}</if>
            <if test="activityEndTime != null "> and activity_end_time = #{activityEndTime}</if>
            <if test="signStartTime != null "> and sign_start_time = #{signStartTime}</if>
            <if test="signEndTime != null "> and sign_end_time = #{signEndTime}</if>
            <if test="activityLocation != null  and activityLocation != ''"> and activity_location = #{activityLocation}</if>
            <if test="maxQuota != null "> and max_quota = #{maxQuota}</if>
            <if test="targetGroup != null  and targetGroup != ''"> and target_group = #{targetGroup}</if>
            <if test="activityDesc != null  and activityDesc != ''"> and activity_desc = #{activityDesc}</if>
            <if test="requiredMaterial != null  and requiredMaterial != ''"> and required_material = #{requiredMaterial}</if>
            <if test="activityStatus != null "> and activity_status = #{activityStatus}</if>
            <if test="createUserId != null  and createUserId != ''"> and create_user_id = #{createUserId}</if>
            <if test="updateUserId != null  and updateUserId != ''"> and update_user_id = #{updateUserId}</if>
            <if test="isDeleted != null "> and is_deleted = #{isDeleted}</if>
        </where>
    </select>
    
    <select id="selectEduPracticeActivityByActivityId" parameterType="String" resultMap="EduPracticeActivityResult">
        <include refid="selectEduPracticeActivityVo"/>
        where activity_id = #{activityId}
    </select>

    <insert id="insertEduPracticeActivity" parameterType="EduPracticeActivity">
        insert into edu_practice_activity
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="activityId != null">activity_id,</if>
            <if test="activityName != null and activityName != ''">activity_name,</if>
            <if test="activityType != null">activity_type,</if>
            <if test="organizer != null and organizer != ''">organizer,</if>
            <if test="coOrganizer != null">co_organizer,</if>
            <if test="activityTime != null">activity_time,</if>
            <if test="activityEndTime != null">activity_end_time,</if>
            <if test="signStartTime != null">sign_start_time,</if>
            <if test="signEndTime != null">sign_end_time,</if>
            <if test="activityLocation != null and activityLocation != ''">activity_location,</if>
            <if test="maxQuota != null">max_quota,</if>
            <if test="targetGroup != null and targetGroup != ''">target_group,</if>
            <if test="activityDesc != null and activityDesc != ''">activity_desc,</if>
            <if test="requiredMaterial != null">required_material,</if>
            <if test="activityStatus != null">activity_status,</if>
            <if test="createUserId != null and createUserId != ''">create_user_id,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateUserId != null and updateUserId != ''">update_user_id,</if>
            <if test="isDeleted != null">is_deleted,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="activityId != null">#{activityId},</if>
            <if test="activityName != null and activityName != ''">#{activityName},</if>
            <if test="activityType != null">#{activityType},</if>
            <if test="organizer != null and organizer != ''">#{organizer},</if>
            <if test="coOrganizer != null">#{coOrganizer},</if>
            <if test="activityTime != null">#{activityTime},</if>
            <if test="activityEndTime != null">#{activityEndTime},</if>
            <if test="signStartTime != null">#{signStartTime},</if>
            <if test="signEndTime != null">#{signEndTime},</if>
            <if test="activityLocation != null and activityLocation != ''">#{activityLocation},</if>
            <if test="maxQuota != null">#{maxQuota},</if>
            <if test="targetGroup != null and targetGroup != ''">#{targetGroup},</if>
            <if test="activityDesc != null and activityDesc != ''">#{activityDesc},</if>
            <if test="requiredMaterial != null">#{requiredMaterial},</if>
            <if test="activityStatus != null">#{activityStatus},</if>
            <if test="createUserId != null and createUserId != ''">#{createUserId},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateUserId != null and updateUserId != ''">#{updateUserId},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
         </trim>
    </insert>

    <update id="updateEduPracticeActivity" parameterType="EduPracticeActivity">
        update edu_practice_activity
        <trim prefix="SET" suffixOverrides=",">
            <if test="activityName != null and activityName != ''">activity_name = #{activityName},</if>
            <if test="activityType != null">activity_type = #{activityType},</if>
            <if test="organizer != null and organizer != ''">organizer = #{organizer},</if>
            <if test="coOrganizer != null">co_organizer = #{coOrganizer},</if>
            <if test="activityTime != null">activity_time = #{activityTime},</if>
            <if test="activityEndTime != null">activity_end_time = #{activityEndTime},</if>
            <if test="signStartTime != null">sign_start_time = #{signStartTime},</if>
            <if test="signEndTime != null">sign_end_time = #{signEndTime},</if>
            <if test="activityLocation != null and activityLocation != ''">activity_location = #{activityLocation},</if>
            <if test="maxQuota != null">max_quota = #{maxQuota},</if>
            <if test="targetGroup != null and targetGroup != ''">target_group = #{targetGroup},</if>
            <if test="activityDesc != null and activityDesc != ''">activity_desc = #{activityDesc},</if>
            <if test="requiredMaterial != null">required_material = #{requiredMaterial},</if>
            <if test="activityStatus != null">activity_status = #{activityStatus},</if>
            <if test="createUserId != null and createUserId != ''">create_user_id = #{createUserId},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateUserId != null and updateUserId != ''">update_user_id = #{updateUserId},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
        </trim>
        where activity_id = #{activityId}
    </update>

    <delete id="deleteEduPracticeActivityByActivityId" parameterType="String">
        delete from edu_practice_activity where activity_id = #{activityId}
    </delete>

    <delete id="deleteEduPracticeActivityByActivityIds" parameterType="String">
        delete from edu_practice_activity where activity_id in 
        <foreach item="activityId" collection="array" open="(" separator="," close=")">
            #{activityId}
        </foreach>
    </delete>
</mapper>