<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.teachingmanagement.mapper.EduMajorMapper">
    
    <resultMap type="EduMajor" id="EduMajorResult">
        <result property="majorId"    column="major_id"    />
        <result property="majorName"    column="major_name"    />
        <result property="majorCode"    column="major_code"    />
        <result property="deptId"    column="dept_id"    />
        <result property="trainingLevel"    column="training_level"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateUserId"    column="update_user_id"    />
        <result property="isDeleted"    column="is_deleted"    />
    </resultMap>

    <sql id="selectEduMajorVo">
        select major_id, major_name, major_code, dept_id, training_level, status, create_time, update_time, update_user_id, is_deleted from edu_major
    </sql>

    <select id="selectEduMajorList" parameterType="EduMajor" resultMap="EduMajorResult">
        <include refid="selectEduMajorVo"/>
        <where>  
            <if test="majorName != null  and majorName != ''"> and major_name like concat('%', #{majorName}, '%')</if>
            <if test="majorCode != null  and majorCode != ''"> and major_code = #{majorCode}</if>
            <if test="deptId != null "> and dept_id = #{deptId}</if>
            <if test="trainingLevel != null  and trainingLevel != ''"> and training_level = #{trainingLevel}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="updateUserId != null  and updateUserId != ''"> and update_user_id = #{updateUserId}</if>
            <if test="isDeleted != null "> and is_deleted = #{isDeleted}</if>
        </where>
    </select>
    
    <select id="selectEduMajorByMajorId" parameterType="Long" resultMap="EduMajorResult">
        <include refid="selectEduMajorVo"/>
        where major_id = #{majorId}
    </select>

    <insert id="insertEduMajor" parameterType="EduMajor">
        insert into edu_major
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="majorId != null">major_id,</if>
            <if test="majorName != null and majorName != ''">major_name,</if>
            <if test="majorCode != null and majorCode != ''">major_code,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="trainingLevel != null">training_level,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateUserId != null and updateUserId != ''">update_user_id,</if>
            <if test="isDeleted != null">is_deleted,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="majorId != null">#{majorId},</if>
            <if test="majorName != null and majorName != ''">#{majorName},</if>
            <if test="majorCode != null and majorCode != ''">#{majorCode},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="trainingLevel != null">#{trainingLevel},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateUserId != null and updateUserId != ''">#{updateUserId},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
         </trim>
    </insert>

    <update id="updateEduMajor" parameterType="EduMajor">
        update edu_major
        <trim prefix="SET" suffixOverrides=",">
            <if test="majorName != null and majorName != ''">major_name = #{majorName},</if>
            <if test="majorCode != null and majorCode != ''">major_code = #{majorCode},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="trainingLevel != null">training_level = #{trainingLevel},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateUserId != null and updateUserId != ''">update_user_id = #{updateUserId},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
        </trim>
        where major_id = #{majorId}
    </update>

    <delete id="deleteEduMajorByMajorId" parameterType="Long">
        delete from edu_major where major_id = #{majorId}
    </delete>

    <delete id="deleteEduMajorByMajorIds" parameterType="String">
        delete from edu_major where major_id in 
        <foreach item="majorId" collection="array" open="(" separator="," close=")">
            #{majorId}
        </foreach>
    </delete>
</mapper>