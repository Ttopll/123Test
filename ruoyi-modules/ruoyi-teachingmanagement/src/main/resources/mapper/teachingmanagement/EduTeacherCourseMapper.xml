<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.teachingmanagement.mapper.EduTeacherCourseMapper">
    
    <resultMap type="EduTeacherCourse" id="EduTeacherCourseResult">
        <result property="tcId"    column="tc_id"    />
        <result property="teacherId"    column="teacher_id"    />
        <result property="courseId"    column="course_id"    />
        <result property="semester"    column="semester"    />
        <result property="classTime"    column="class_time"    />
        <result property="classRoom"    column="class_room"    />
        <result property="studentLimit"    column="student_limit"    />
        <result property="status"    column="status"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
        <result property="updateUserId"    column="update_user_id"    />
        <result property="isDeleted"    column="is_deleted"    />
    </resultMap>

    <sql id="selectEduTeacherCourseVo">
        select tc_id, teacher_id, course_id, semester, class_time, class_room, student_limit, status, create_time, update_time, update_user_id, is_deleted from edu_teacher_course
    </sql>

    <select id="selectEduTeacherCourseList" parameterType="EduTeacherCourse" resultMap="EduTeacherCourseResult">
        <include refid="selectEduTeacherCourseVo"/>
        <where>  
            <if test="teacherId != null  and teacherId != ''"> and teacher_id = #{teacherId}</if>
            <if test="courseId != null "> and course_id = #{courseId}</if>
            <if test="semester != null  and semester != ''"> and semester = #{semester}</if>
            <if test="classTime != null  and classTime != ''"> and class_time = #{classTime}</if>
            <if test="classRoom != null  and classRoom != ''"> and class_room = #{classRoom}</if>
            <if test="studentLimit != null "> and student_limit = #{studentLimit}</if>
            <if test="status != null "> and status = #{status}</if>
            <if test="updateUserId != null  and updateUserId != ''"> and update_user_id = #{updateUserId}</if>
            <if test="isDeleted != null "> and is_deleted = #{isDeleted}</if>
        </where>
    </select>
    
    <select id="selectEduTeacherCourseByTcId" parameterType="Long" resultMap="EduTeacherCourseResult">
        <include refid="selectEduTeacherCourseVo"/>
        where tc_id = #{tcId}
    </select>

    <insert id="insertEduTeacherCourse" parameterType="EduTeacherCourse">
        insert into edu_teacher_course
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="tcId != null">tc_id,</if>
            <if test="teacherId != null and teacherId != ''">teacher_id,</if>
            <if test="courseId != null">course_id,</if>
            <if test="semester != null and semester != ''">semester,</if>
            <if test="classTime != null">class_time,</if>
            <if test="classRoom != null">class_room,</if>
            <if test="studentLimit != null">student_limit,</if>
            <if test="status != null">status,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="updateUserId != null and updateUserId != ''">update_user_id,</if>
            <if test="isDeleted != null">is_deleted,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="tcId != null">#{tcId},</if>
            <if test="teacherId != null and teacherId != ''">#{teacherId},</if>
            <if test="courseId != null">#{courseId},</if>
            <if test="semester != null and semester != ''">#{semester},</if>
            <if test="classTime != null">#{classTime},</if>
            <if test="classRoom != null">#{classRoom},</if>
            <if test="studentLimit != null">#{studentLimit},</if>
            <if test="status != null">#{status},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateUserId != null and updateUserId != ''">#{updateUserId},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
         </trim>
    </insert>

    <update id="updateEduTeacherCourse" parameterType="EduTeacherCourse">
        update edu_teacher_course
        <trim prefix="SET" suffixOverrides=",">
            <if test="teacherId != null and teacherId != ''">teacher_id = #{teacherId},</if>
            <if test="courseId != null">course_id = #{courseId},</if>
            <if test="semester != null and semester != ''">semester = #{semester},</if>
            <if test="classTime != null">class_time = #{classTime},</if>
            <if test="classRoom != null">class_room = #{classRoom},</if>
            <if test="studentLimit != null">student_limit = #{studentLimit},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="updateUserId != null and updateUserId != ''">update_user_id = #{updateUserId},</if>
            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
        </trim>
        where tc_id = #{tcId}
    </update>

    <delete id="deleteEduTeacherCourseByTcId" parameterType="Long">
        delete from edu_teacher_course where tc_id = #{tcId}
    </delete>

    <delete id="deleteEduTeacherCourseByTcIds" parameterType="String">
        delete from edu_teacher_course where tc_id in 
        <foreach item="tcId" collection="array" open="(" separator="," close=")">
            #{tcId}
        </foreach>
    </delete>
</mapper>