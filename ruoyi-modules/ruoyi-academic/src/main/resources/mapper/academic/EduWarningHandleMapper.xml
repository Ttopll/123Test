            <if test="verifyUserId != null">#{verifyUserId},</if>
            <if test="verifyTime != null">#{verifyTime},</if>
            <if test="verifyRemark != null">#{verifyRemark},</if>
            <if test="attachUrl != null">#{attachUrl},</if>
            <if test="remark != null">#{remark},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="updateUserId != null and updateUserId != ''">#{updateUserId},</if>
            <if test="isDeleted != null">#{isDeleted},</if>
         </trim>
    </insert>

    <update id="updateEduWarningHandle" parameterType="EduWarningHandle">
        update edu_warning_handle
        <trim prefix="SET" suffixOverrides=",">
            <if test="warningId != null">warning_id = #{warningId},</if>
            <if test="studentId != null and studentId != ''">student_id = #{studentId},</if>
            <if test="handlerId != null and handlerId != ''">handler_id = #{handlerId},</if>
            <if test="handleType != null">handle_type = #{handleType},</if>
            <if test="handleTitle != null and handleTitle != ''">handle_title = #{handleTitle},</if>
