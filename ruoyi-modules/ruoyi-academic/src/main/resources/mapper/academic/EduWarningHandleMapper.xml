<mapper namespace="com.ruoyi.academic.mapper.EduWarningHandleMapper">
    
    <resultMap type="EduWarningHandle" id="EduWarningHandleResult">
        <result property="handleId"    column="handle_id"    />
        <result property="warningId"    column="warning_id"    />
        <result property="studentId"    column="student_id"    />
        <result property="handlerId"    column="handler_id"    />
