            <if test="isDeleted != null">is_deleted = #{isDeleted},</if>
        </trim>
        where handle_id = #{handleId}
    </update>

    <delete id="deleteEduWarningHandleByHandleId" parameterType="Long">
        delete from edu_warning_handle where handle_id = #{handleId}
    </delete>

    <delete id="deleteEduWarningHandleByHandleIds" parameterType="String">
        delete from edu_warning_handle where handle_id in 
        <foreach item="handleId" collection="array" open="(" separator="," close=")">
            #{handleId}
        </foreach>
    </delete>
</mapper>