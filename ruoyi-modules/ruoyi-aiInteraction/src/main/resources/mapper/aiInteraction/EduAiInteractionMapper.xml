    <sql id="selectEduAiInteractionVo">
        select interaction_id, user_id, interaction_type, interaction_status, request_content, response_content, interaction_time, is_collect, document_url, image_url, guide_function, create_time, update_time, update_user_id, is_deleted from edu_ai_interaction
    </sql>

    <select id="selectEduAiInteractionList" parameterType="EduAiInteraction" resultMap="EduAiInteractionResult">
        <include refid="selectEduAiInteractionVo"/>
        <where>  
            <if test="userId != null  and userId != ''"> and user_id = #{userId}</if>
            <if test="interactionType != null "> and interaction_type = #{interactionType}</if>
            <if test="interactionStatus != null "> and interaction_status = #{interactionStatus}</if>
            <if test="requestContent != null  and requestContent != ''"> and request_content = #{requestContent}</if>
            <if test="responseContent != null  and responseContent != ''"> and response_content = #{responseContent}</if>
            <if test="interactionTime != null "> and interaction_time = #{interactionTime}</if>
            <if test="isCollect != null "> and is_collect = #{isCollect}</if>
            <if test="documentUrl != null  and documentUrl != ''"> and document_url = #{documentUrl}</if>
            <if test="imageUrl != null  and imageUrl != ''"> and image_url = #{imageUrl}</if>
            <if test="guideFunction != null  and guideFunction != ''"> and guide_function = #{guideFunction}</if>
            <if test="updateUserId != null  and updateUserId != ''"> and update_user_id = #{updateUserId}</if>
            <if test="isDeleted != null "> and is_deleted = #{isDeleted}</if>
        </where>
    </select>
    
    <select id="selectEduAiInteractionByInteractionId" parameterType="String" resultMap="EduAiInteractionResult">
        <include refid="selectEduAiInteractionVo"/>
        where interaction_id = #{interactionId}
    </select>

    <insert id="insertEduAiInteraction" parameterType="EduAiInteraction">
