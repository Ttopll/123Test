    <delete id="deleteEduAiInteractionByInteractionIds" parameterType="String">
        delete from edu_ai_interaction where interaction_id in 
        <foreach item="interactionId" collection="array" open="(" separator="," close=")">
            #{interactionId}
        </foreach>
    </delete>
</mapper>