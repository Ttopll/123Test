<mapper namespace="com.ruoyi.aiInteraction.mapper.EduAiInteractionMapper">
    
    <resultMap type="EduAiInteraction" id="EduAiInteractionResult">
        <result property="interactionId"    column="interaction_id"    />
        <result property="userId"    column="user_id"    />
        <result property="interactionType"    column="interaction_type"    />
        <result property="interactionStatus"    column="interaction_status"    />
