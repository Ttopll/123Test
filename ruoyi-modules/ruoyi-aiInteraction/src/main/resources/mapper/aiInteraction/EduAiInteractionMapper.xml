            <if test="responseContent != null">response_content = #{responseContent},</if>
            <if test="interactionTime != null">interaction_time = #{interactionTime},</if>
            <if test="isCollect != null">is_collect = #{isCollect},</if>
            <if test="documentUrl != null">document_url = #{documentUrl},</if>
            <if test="imageUrl != null">image_url = #{imageUrl},</if>
            <if test="guideFunction != null">guide_function = #{guideFunction},</if>
